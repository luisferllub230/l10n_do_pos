<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inhertit_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">l10n.do.pos.config.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//block[@id='pos_accounting_section']" position="before">
                <block title="Docminican POS localization settings" id="l10n_do_pos_section">
                    <setting id="l10n_default_partner_id" title="Default customer">
                        <div class="content-group mt16">
                            <field name="l10n_default_partner_id" readonly="pos_has_active_session" />
                            <div class="text-warning" id="warning_text_employees">
                                The pos take the default customer from the POS configuration
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>

       </field>
    </record>
</odoo>