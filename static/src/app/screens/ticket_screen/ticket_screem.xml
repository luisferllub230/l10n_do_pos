<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('header-row')]/div[1]" position="before">
            <div class="col wide p-2">NCF</div>
        </xpath>

        <xpath expr="//t[@t-if='!ui.isSmall']/div[1]/div[1]" position="before">
            <div class="col wide p-2 ">
                <div><t t-esc="order.pos_ncf" t-if="order.pos_ncf"></t></div>
            </div>
        </xpath>

        <xpath expr="//t[@t-if='ui.isSmall']/div[1]/div[1]" position="before">
            <div class="col wide p-2 ">
                <div><t t-esc="order.pos_ncf" t-if="order.pos_ncf"></t></div>
            </div>
        </xpath>
    </t>

</templates>