<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="OrderReceipt" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="attributes">
            <attribute name="style">font-size: 106%;</attribute>
        </xpath>
        
        <xpath expr="//div[@t-if='props.data.trackingNumber and !props.data.bigTrackingNumber']" position="replace"/>
        
        <xpath expr="//div[@t-if='props.data.cashier']" position="before">  
            <h4 t-if="props.data.pos_latam_document_type_name">
                Factura de <t t-esc="props.data.pos_latam_document_type_name"/>
            </h4>
            <h4 t-if="props.data.pos_ncf">
                NCF: <t t-esc="props.data.pos_ncf"/>
            </h4>
            <div t-if="props.data.pos_reference">
                <t t-esc="props.data.pos_reference"/>
            </div>
            <div t-if="props.data.pos_date">
                <t t-esc="props.data.pos_date"/>
            </div>
            <t t-if="props.data.partner">
                <div>
                    Cliente: <t t-esc="props.data.partner.name"/>
                </div>
                <div t-if="props.data.partner.vat">
                    RNC/CED: <t t-esc="receipt.partner.vat"/>
                </div>
            </t>
        </xpath>
    </t>

</templates>